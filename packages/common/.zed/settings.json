{
  "languages": {
    "JavaScript": {
      "code_actions_on_format": {
        "source.action.useSortedKeys.biome": true,
        "source.fixAll.biome": true,
        "source.organizeImports": false,
        "source.organizeImports.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome", "typescript-ls", "!typescript-language-server", "!vtsls", "..."]
    },
    "JSON": {
      "code_actions_on_format": {
        "source.action.useSortedKeys.biome": true,
        "source.action.useSortedPackageJson.biome": true,
        "source.fixAll.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome", "..."]
    },
    "JSONC": {
      "code_actions_on_format": {
        "source.action.useSortedKeys.biome": true,
        "source.action.useSortedPackageJson.biome": true,
        "source.fixAll.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome", "..."]
    },
    "JSX": {
      "code_actions_on_format": {
        "source.action.useSortedKeys.biome": true,
        "source.fixAll.biome": true,
        "source.organizeImports": false,
        "source.organizeImports.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome", "typescript-ls", "!typescript-language-server", "!vtsls", "..."]
    },
    "TSX": {
      "code_actions_on_format": {
        "source.action.useSortedKeys.biome": true,
        "source.fixAll.biome": true,
        "source.organizeImports": false,
        "source.organizeImports.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome", "typescript-ls", "!typescript-language-server", "!vtsls", "..."]
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.action.useSortedKeys.biome": true,
        "source.fixAll.biome": true,
        "source.organizeImports": false,
        "source.organizeImports.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome", "typescript-ls", "!typescript-language-server", "!vtsls", "..."]
    }
  },
  "lsp": {
    "biome": {
      "binary": {
        "arguments": ["../../node_modules/@biomejs/biome/bin/biome", "lsp-proxy"],
        "path": "node"
      },
      "settings": {
        "config_path": "../../biome.jsonc",
        "inline_config": null,
        "require_config_file": true
      }
    },
    "typescript-ls": {
      "binary": {
        "arguments": ["../../node_modules/typescript/bin/tsc", "--lsp", "--stdio"],
        "path": "node"
      }
    }
  }
}

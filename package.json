{
  "name": "axutils",
  "private": true,
  "homepage": "https://github.com/crx-96/axutils#readme",
  "bugs": {
    "url": "https://github.com/crx-96/axutils/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crx-96/axutils.git"
  },
  "scripts": {
    "biome:check": "node ./node_modules/@biomejs/biome/bin/biome check .",
    "build": "pnpm -r build",
    "changeset": "changeset",
    "check": "node ./scripts/workspace.mjs check",
    "format": "node ./node_modules/@biomejs/biome/bin/biome format --write .",
    "lint": "node ./node_modules/@biomejs/biome/bin/biome check .",
    "publint": "node ./scripts/workspace.mjs publint",
    "release": "changeset publish",
    "test": "pnpm -r test",
    "test:browser": "node ./scripts/workspace.mjs test:browser",
    "test:consumer": "node ./scripts/workspace.mjs test:consumer",
    "test:dist": "node ./scripts/workspace.mjs test:dist",
    "test:runtime": "node ./scripts/runtime-smoke.mjs",
    "test:tooling": "node --test scripts/test/*.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@changesets/cli": "3.0.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "24.12.4",
    "publint": "0.3.21",
    "typescript": "7.0.1-rc",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "^22.11 || ^24 || >=26",
    "pnpm": ">=10.0.0"
  }
}
